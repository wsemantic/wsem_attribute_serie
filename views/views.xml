<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Menú principal -->
        <menuitem id="menu_attribute_serie" name="Series Tallas" parent="sale.sale_menu_root"
            sequence="10" />

        <!-- Acción para abrir la vista de lista de series de atributos -->
        <record id="action_attribute_serie" model="ir.actions.act_window">
            <field name="name">Series Tallas</field>
            <field name="res_model">attribute.serie</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Menú para la acción de series de atributos -->
        <menuitem id="menu_attribute_serie_list" name="Series Tallas" parent="menu_attribute_serie"
            action="action_attribute_serie" sequence="1" />

        <!-- Vista de lista para series de atributos -->
        <record id="view_attribute_serie_tree" model="ir.ui.view">
            <field name="name">attribute.serie.tree</field>
            <field name="model">attribute.serie</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" />
                </list>
            </field>
        </record>


        <!-- Vista de formulario para series de atributos -->
        <record id="view_attribute_serie_form" model="ir.ui.view">
            <field name="name">attribute.serie.form</field>
            <field name="model">attribute.serie</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name" />
                        </group>
                        <notebook>
                            <page string="Items">
                                <field name="item_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle" />
                                        <field name="attribute_value_id" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_product_template_product_form_inherit" model="ir.ui.view">
            <field name="name">product.template.product.form.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view" />

            <field name="arch" type="xml">
                <xpath expr="//field[@name='categ_id']" position="after">
                    <field name="attribute_serie_id" />
                </xpath>
            </field>
        </record>

        <!-- Permitir abrir la cuadrícula de variantes (lápiz) en pedidos de compra
             ya confirmados. Odoo pone product_template_id en solo lectura a partir
             del estado 'purchase', lo que oculta el botón de configuración del
             widget pol_product_many2one. Al quitar esa restricción se pueden
             modificar cantidades desde la matriz; Odoo se encarga de generar la
             recepción adicional y de recalcular los estados de recepción/factura. -->
        <record id="purchase_order_form_matrix_editable" model="ir.ui.view">
            <field name="name">purchase.order.form.matrix.editable</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase_product_matrix.purchase_order_form_matrix" />
            <field name="arch" type="xml">
                <xpath expr="//list/field[@name='product_template_id']" position="attributes">
                    <attribute name="readonly">state == 'cancel'</attribute>
                </xpath>
            </field>
        </record>


    </data>
</odoo>